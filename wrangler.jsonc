{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astrology-engine-web-local",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  // CMS copy via Service Binding (docs/designs/cms.md §9.1). Bindings are not
  // inherited by environments, so each environment names its CMS Worker.
  "services": [{ "binding": "CMS", "service": "astrology-engine-cms-local" }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
    },
  },
  "env": {
    "staging": {
      "preview_urls": true,
      "previews": {},
      "name": "astrology-engine-web-staging",
      "services": [
        { "binding": "CMS", "service": "astrology-engine-cms-staging" },
      ],
      "routes": [
        {
          "pattern": "staging.astrologyengine.dev",
          "custom_domain": true,
        },
      ],
    },
    "alpha": {
      "name": "astrology-engine-web-alpha",
      "services": [
        { "binding": "CMS", "service": "astrology-engine-cms-alpha" },
      ],
      "routes": [
        {
          "pattern": "alpha.astrologyengine.dev",
          "custom_domain": true,
        },
      ],
    },
  },
}
