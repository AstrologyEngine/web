{
  "name": "cms",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:e2e": "bun scripts/dev-e2e.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "migrate:alpha": "wrangler d1 migrations apply DB --remote --env alpha",
    "seed:local": "bun scripts/seed.ts --local",
    "seed:staging": "bun scripts/seed.ts --env staging",
    "seed:alpha": "bun scripts/seed.ts --env alpha",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:alpha": "wrangler deploy --env alpha"
  },
  "dependencies": {
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.13",
    "@cloudflare/workers-types": "5.20261029.1",
    "@types/bun": "1.3.14",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14"
}
