{
  "name": "web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "sync": "svelte-kit sync",
    "check": "rsvelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:ts": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "oxlint .",
    "format": "rsvelte-fmt .",
    "format:check": "rsvelte-fmt --check .",
    "build": "node scripts/build-info.mjs && vite build",
    "dry-run": "wrangler deploy --dry-run",
    "test:browser": "playwright test",
    "changeset": "changeset",
    "version:release": "changeset version && bun install --lockfile-only && bun run format",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@rsvelte/fmt": "0.7.25",
    "@rsvelte/oxlint-plugin": "0.2.6",
    "@rsvelte/svelte-check": "0.5.32",
    "@sveltejs/adapter-cloudflare": "8.0.2",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "npm:@rsvelte/vite-plugin-svelte@0.5.3",
    "@types/node": "24.10.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "svelte": "5.57.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "@sveltejs/vite-plugin-svelte": "npm:@rsvelte/vite-plugin-svelte@0.5.3"
  },
  "engines": {
    "node": "24.10.0"
  },
  "packageManager": "bun@1.3.14"
}
