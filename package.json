{
  "name": "web",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run worker:build && node scripts/cms-snapshot.mjs && vite dev",
    "sync": "svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:ts": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "oxlint --disable-nested-config . && node scripts/check-copy.mjs",
    "format": "oxfmt --disable-nested-config . && prettier --plugin prettier-plugin-svelte --write \"**/*.svelte\"",
    "format:check": "oxfmt --disable-nested-config --check . && prettier --plugin prettier-plugin-svelte --check \"**/*.svelte\"",
    "build": "bun run worker:build && node scripts/build-info.mjs && node scripts/cms-snapshot.mjs && vite build",
    "dry-run": "wrangler deploy --dry-run",
    "test:browser": "playwright test",
    "changeset": "changeset",
    "version:release": "changeset version && bun install --lockfile-only && bun run format",
    "release:publish": "node scripts/publish-release.mjs",
    "worker:build": "bun build src/lib/calculation/worker.ts --target browser --outfile static/calculation-worker.js",
    "dev:stack": "node scripts/dev-stack.mjs"
  },
  "dependencies": {
    "@astrologyengine/cms-contract": "https://github.com/AstrologyEngine/cms/releases/download/v0.1.0/cms-contract-0.1.0.tgz",
    "@js-temporal/polyfill": "0.5.1",
    "chrono-node": "2.10.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.59.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.10.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": "24.10.0"
  },
  "packageManager": "bun@1.3.14"
}
